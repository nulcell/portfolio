---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const skills = [
  {
    group: 'Cloud & Infrastructure',
    items: ['AWS', 'Kubernetes', 'Docker', 'Terraform', 'Talos', 'ArgoCD', 'Okta'],
  },
  {
    group: 'Security',
    items: [
      'Threat Modeling',
      'Vulnerability Management',
      'Penetration Testing',
      'Web & API Security',
      'DAST / SAST',
      'Security Automation',
    ],
  },
  {
    group: 'Languages',
    items: ['Python', 'Bash', 'JavaScript', 'SQL', 'Go'],
  },
  {
    group: 'CI/CD & Tooling',
    items: [
      'GitHub Actions',
      'CloudFormation',
      'AWS CDK',
      'Burp Suite Pro',
      'Grafana',
      'OpenSearch',
      'Prometheus',
      'Sysdig',
      'Falco',
      'Tailscale',
      'Netskope',
    ],
  },
  {
    group: 'Compliance',
    items: ['ISO 27001', 'SOC 2 Type II', 'Vanta', 'Audit Coordination'],
  },
];

const experience = [
  {
    role: 'Security Engineer',
    org: 'Mambu',
    location: 'Amsterdam, NL',
    period: 'Nov 2024 – Present',
    blurb:
      'Cloud infrastructure security, threat modelling, and risk analysis for new product capabilities.',
  },
  {
    role: 'Cloud Engineer',
    org: 'AMMP Technologies',
    location: 'Amsterdam, NL',
    period: 'Dec 2023 – Oct 2024',
    blurb:
      'Led ISO 27001 and SOC 2 Type II certification, cut impactful vulnerabilities by 60%, and redesigned CI/CD pipelines while keeping AWS costs trending down.',
  },
  {
    role: 'Data Engineer',
    org: 'AMMP Technologies',
    location: 'Amsterdam, NL',
    period: 'Jun 2022 – Dec 2023',
    blurb:
      'Built 20+ serverless applications and 10+ containerised services in Python; cut AWS compute costs +20%.',
  },
];

const certifications = [
  'KCNA: Kubernetes and Cloud Native Associate',
  'AWS Certified Security – Specialty',
  'AWS Certified Solutions Architect – Professional',
  'AWS Certified Solutions Architect – Associate',
  'AWS Certified Cloud Practitioner',
];

const projects = [
  {
    name: 'homecloud',
    href: 'https://github.com/nulcell/homecloud',
    blurb:
      'Self-hosted private cloud on bare metal - Talos, Cilium, ArgoCD, Longhorn, KubeVirt. The cluster this site runs on.',
    meta: 'Kubernetes · GitOps',
  },
  {
    name: 'Tools-Install',
    href: 'https://github.com/nulcell/Tools-Install',
    blurb:
      'Automated installer and checker for common cybersecurity tooling.',
    meta: 'Shell',
  },
  {
    name: 'proxy-forward',
    href: 'https://github.com/nulcell/proxy-forward',
    blurb:
      'Pivot helper: proxies ports on internal machines and generates the port-forward command for the attacker box.',
    meta: 'Shell · Red team',
  },
];

const socials = [
  { name: 'GitHub', href: 'https://github.com/nulcell', icon: 'github' },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/toyin-ayanleye',
    icon: 'linkedin',
  },
  { name: 'X', href: 'https://x.com/nulcell', icon: 'x' },
  { name: 'HackerOne', href: 'https://hackerone.com/nulcell', icon: 'h1' },
  {
    name: 'Email',
    href: 'mailto:salimon.ayanleye@nulcell.com',
    icon: 'mail',
  },
  { name: 'Résumé', href: '/resume.pdf', icon: 'file' },
];

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<Base title="Toyin Ayanleye - Cloud Security Engineer">
  <section class="hero">
    <img
      class="headshot"
      src="/headshot.jpg"
      alt="Portrait of Toyin Ayanleye"
      width="152"
      height="152"
    />
    <div>
      <h1>Toyin Ayanleye</h1>
      <p class="tagline">Cloud Security Engineer</p>
      <p class="meta">The Hague, Netherlands</p>
      <ul class="socials">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('/') ? undefined : '_blank'}
                rel="noopener"
              >
                {s.icon === 'github' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.97c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.18a11 11 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.15c0 .31.21.68.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
                  </svg>
                )}
                {s.icon === 'linkedin' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" />
                  </svg>
                )}
                {s.icon === 'x' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z" />
                  </svg>
                )}
                {s.icon === 'h1' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M6 3v18M6 12h7M13 5l4-2v18" />
                  </svg>
                )}
                {s.icon === 'mail' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m2 7 10 6L22 7" />
                  </svg>
                )}
                {s.icon === 'file' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linejoin="round"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <path d="M14 2v6h6M9 13h6M9 17h6" />
                  </svg>
                )}
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="prose">
    <h2>About</h2>
    <p>
      I design, deploy, and secure cloud infrastructure on AWS and Kubernetes.
      I've led ISO 27001 and SOC 2 Type II certification efforts end to end,
      built out vulnerability management systems, and spent some time on the dark side 
      (bug bounties, penetration testing, and web app testing) to know how the things get broken.
    </p>
    <p>
      Outside work I run <a href="https://github.com/nulcell/homecloud"
        >homecloud</a
      >, a bare-metal Kubernetes cluster that hosts this site and a growing
      collection of self-hosted <a href="https://status.nulcell.com/status/services"
        >services</a
      > to understand cloud-native systems and learn from building a small one.
    </p>
  </section>

  <section>
    <h2>Experience</h2>
    <ul class="timeline">
      {
        experience.map((e) => (
          <li>
            <span class="role">{e.role}</span>
            <span class="org"> · {e.org}, {e.location}</span>
            <div class="period">{e.period}</div>
            <p>{e.blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Projects</h2>
    <div class="card-grid">
      {
        projects.map((p) => (
          <a class="card" href={p.href} target="_blank" rel="noopener">
            <h3>{p.name}</h3>
            <p>{p.blurb}</p>
            <span class="card-meta">{p.meta}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Skills</h2>
    {
      skills.map((s) => (
        <div class="skill-group">
          <h3>{s.group}</h3>
          <ul class="tags">
            {s.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section>
    <h2>Certifications</h2>
    <ul class="tags">
      {certifications.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section>
        <h2>Recent posts</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <span class="post-date">{fmt.format(post.data.date)}</span>
              <h3>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
